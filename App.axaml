<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lana.App"
             xmlns:local="using:Lana"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lana/Themes/AppTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.brand-mark">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="3"/>
    </Style>

    <Style Selector="TextBlock.hero-title">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
      <Setter Property="FontSize" Value="42"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LineHeight" Value="50"/>
    </Style>

    <Style Selector="TextBlock.hero-subtitle">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="LineHeight" Value="24"/>
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 表单字段旁提示标：圆形 i，悬停显示 ToolTip -->
    <Style Selector="Border.field-hint-badge">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip.ShowDelay" Value="150"/>
    </Style>

    <Style Selector="Border.field-hint-badge:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppNavActiveBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style Selector="Border.field-hint-badge TextBlock">
      <Setter Property="Text" Value="i"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif"/>
    </Style>

    <Style Selector="TextBlock.section-eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.muted-text">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.body-text">
      <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style Selector="TextBlock.primary-text">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.secondary-text">
      <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.accent-text">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.on-accent-text">
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
    </Style>

    <Style Selector="Border.glass-panel">
      <Setter Property="Background" Value="{DynamicResource AppGlassBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AppGlassShadow}"/>
    </Style>

    <Style Selector="Border.glow-card">
      <Setter Property="BoxShadow" Value="{DynamicResource AppGlowShadow}"/>
    </Style>

    <Style Selector="Border.side-rail">
      <Setter Property="Background" Value="{DynamicResource AppSideRailBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AppSideShadow}"/>
    </Style>

    <Style Selector="Border.top-bar">
      <Setter Property="Background" Value="{DynamicResource AppTopBarBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.content-host">
      <Setter Property="Background" Value="{DynamicResource AppContentHostBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.hero-banner">
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource AppHeroBannerBrush}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AppHeroShadow}"/>
    </Style>

    <Style Selector="Border.stat-card">
      <Setter Property="Background" Value="{DynamicResource AppStatCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style Selector="Border.user-chip">
      <Setter Property="Background" Value="{DynamicResource AppUserChipBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.live-pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource AppCtaGradientBrush}"/>
    </Style>

    <Style Selector="Border.orbit-badge">
      <Setter Property="BoxShadow" Value="{DynamicResource AppGlowShadow}"/>
    </Style>

    <Style Selector="Border.theme-card">
      <Setter Property="Background" Value="{DynamicResource AppStatCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.theme-card.theme-selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Background" Value="{DynamicResource AppNavActiveBrush}"/>
    </Style>

    <Style Selector="Border.tag-chip">
      <Setter Property="Background" Value="{DynamicResource AppTagBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="TextBox.neon-input">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style Selector="TextBox.neon-input:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AppInputFocusBrush}"/>
    </Style>

    <Style Selector="Button.cta-button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource AppCtaGradientBrush}"/>
    </Style>

    <Style Selector="Button.cta-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style Selector="Button.cta-button:disabled">
      <Setter Property="Opacity" Value="0.65"/>
    </Style>

    <Style Selector="Button.nav-button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
    </Style>

    <Style Selector="Button.nav-button.nav-active">
      <Setter Property="Background" Value="{DynamicResource AppNavActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.ghost-button">
      <Setter Property="Background" Value="{DynamicResource AppGhostBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Button.ghost-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppGhostHoverBrush}"/>
    </Style>

    <Style Selector="Button.link-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.link-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="CheckBox.remember-me">
      <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="ListBox.entity-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppListItemSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppListItemSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem:selected Border.list-item-card">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.entity-list ListBoxItem:pointerover Border.list-item-card">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.list-item-card">
      <Setter Property="Background" Value="{DynamicResource AppListItemBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppListItemBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>

    <Style Selector="Border.list-item-index">
      <Setter Property="Background" Value="{DynamicResource AppListIndexBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppListItemBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style Selector="Border.list-item-divider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="Background" Value="{DynamicResource AppListDividerBrush}"/>
    </Style>

    <Style Selector="Border.preview-pick-card">
      <Setter Property="Background" Value="{DynamicResource AppListItemBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppListItemBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Border.preview-pick-card.preview-picked">
      <Setter Property="Background" Value="{DynamicResource AppListItemSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- 手动操作页：圆形按钮（读/写） -->
    <Style Selector="Button.defined-op-circle">
      <Setter Property="Width" Value="76"/>
      <Setter Property="Height" Value="76"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AppCtaGradientBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.defined-op-circle:pointerover">
      <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <Style Selector="Button.defined-op-circle:pressed">
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="RenderTransform" Value="scale(0.94)"/>
    </Style>

    <Style Selector="Button.defined-op-circle:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- 手动操作页：圆形点动（Bool 按住） -->
    <Style Selector="Border.defined-op-circle">
      <Setter Property="Width" Value="76"/>
      <Setter Property="Height" Value="76"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource AppCtaGradientBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AppGlowShadow}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.defined-op-circle:pointerover">
      <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <Style Selector="Border.defined-op-circle.pressed">
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="RenderTransform" Value="scale(0.94)"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="BoxShadow" Value="0 2 8 0 #35000000"/>
    </Style>

    <Style Selector="TextBlock.status-value">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.status-value.changed">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
    </Style>
  </Application.Styles>
</Application>
