<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lana.ViewModels"
             x:Class="Lana.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" Margin="8" MaxWidth="860" HorizontalAlignment="Center">
      <Border Classes="glass-panel" Padding="28">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
          <Border Width="72" Height="72" CornerRadius="20"
                  Background="{DynamicResource AppAccentGradientBrush}"
                  HorizontalAlignment="Center">
            <TextBlock Text="LA" FontSize="28" FontWeight="Bold" Classes="on-accent-text"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Title}" Classes="section-title" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Subtitle}" Classes="muted-text" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Classes="glass-panel" Padding="22">
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Text="版本" Classes="field-label"/>
          <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="secondary-text"/>

          <TextBlock Grid.Row="1" Text="运行时" Classes="field-label"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Runtime}" Classes="secondary-text"/>

          <TextBlock Grid.Row="2" Text="UI 框架" Classes="field-label"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UiFramework}" Classes="secondary-text"/>

          <TextBlock Grid.Row="3" Text="数据库" Classes="field-label"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Database}" Classes="secondary-text"/>

          <TextBlock Grid.Row="4" Text="视频引擎" Classes="field-label"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VideoEngine}" Classes="secondary-text"/>
        </Grid>
      </Border>

      <Border Classes="glass-panel" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Text="已包含能力" FontSize="18" FontWeight="SemiBold" Classes="primary-text"/>
          <ItemsControl ItemsSource="{Binding Features}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                  <Border Width="8" Height="8" CornerRadius="4"
                          Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding}" Classes="secondary-text"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="glass-panel" Padding="22">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="开源许可" FontSize="18" FontWeight="SemiBold" Classes="primary-text"/>
            <TextBlock Text="第三方组件声明（摄像头预览相关）" Classes="muted-text" FontSize="12"/>
          </StackPanel>

          <TextBlock Text="{Binding LgplSummary}" Classes="secondary-text" TextWrapping="Wrap" FontSize="13"/>

          <ItemsControl ItemsSource="{Binding OpenSourceComponents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OpenSourceComponent">
                <Border Classes="stat-card" Padding="14" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Name}" Classes="primary-text" FontWeight="SemiBold"/>
                    <TextBlock Classes="accent-text" FontSize="12">
                      <Run Text="许可："/><Run Text="{Binding License}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Notes}" Classes="muted-text" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SourceUrl}" Classes="muted-text" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost-button" Content="打开 LibVLCSharp 源码"
                    Command="{Binding OpenLibVlcSharpSourceCommand}"/>
            <Button Classes="ghost-button" Content="打开 LibVLC 源码"
                    Command="{Binding OpenLibVlcSourceCommand}"/>
            <Button Classes="ghost-button" Content="在线查看 LGPL-2.1"
                    Command="{Binding OpenLgplOnlineCommand}"/>
          </StackPanel>

          <TextBlock Text="NOTICE-LibVLC.txt" Classes="field-label"/>
          <TextBox Text="{Binding NoticeText}" Classes="neon-input" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="140"
                   VerticalContentAlignment="Top"/>

          <TextBlock Text="LGPL-2.1 全文" Classes="field-label"/>
          <TextBox Text="{Binding LicenseText}" Classes="neon-input" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="220"
                   VerticalContentAlignment="Top"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
