<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lana.ViewModels"
             x:Class="Lana.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Grid>
    <Grid Background="{DynamicResource AppLoginBackgroundBrush}">
      <Ellipse Width="420" Height="420" Margin="-80,-120,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55"
               Fill="{DynamicResource AppGlowTealBrush}"/>
      <Ellipse Width="380" Height="380" Margin="0,-40,-100,0"
               HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4"
               Fill="{DynamicResource AppGlowAmberBrush}"/>
      <Ellipse Width="520" Height="280" Margin="0,0,-40,-80"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.35"
               Fill="{DynamicResource AppGlowBlueBrush}"/>
    </Grid>

    <Grid ColumnDefinitions="*,Auto,*">
      <Border Grid.Column="0" Padding="56,40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="20" MaxWidth="420">
          <Border Width="64" Height="64" CornerRadius="18" Classes="glow-card"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AppAccentGradientBrush}">
            <TextBlock Text="LA" FontSize="24" FontWeight="Bold" Classes="on-accent-text"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Text="LANA" Classes="brand-mark" HorizontalAlignment="Left"/>
          <TextBlock Text="设备接入端" Classes="hero-title" TextWrapping="Wrap"/>
          <TextBlock Text="支持modbus、modbus-tcp、rtu、dtu / tcp / http协议的设备接入，支持摄像头RTSP流。通过http上报采集设备数据，以及通过mqtt指令下发控制 ，覆盖 Windows / Linux / macOS。登录后进入沉浸式工作台，数据由本地 SQLite 持久化。"
                     Classes="hero-subtitle" TextWrapping="Wrap"/>

          <StackPanel Spacing="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Text=".NET 9 原生性能" Classes="muted-text" FontSize="14"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="8" Height="8" CornerRadius="4" Background="#F0B429" VerticalAlignment="Center"/>
              <TextBlock Text="Avalonia 跨平台 UI" Classes="muted-text" FontSize="14"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="8" Height="8" CornerRadius="4" Background="#22A6F2" VerticalAlignment="Center"/>
              <TextBlock Text="SQLite 本地数据存储" Classes="muted-text" FontSize="14"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Width="1" Margin="0,64"
              VerticalAlignment="Stretch" Opacity="0.55"
              Background="{DynamicResource AppDividerBrush}"/>

      <Border Grid.Column="2" Padding="56,40">
        <Border Classes="glass-panel" Padding="36" VerticalAlignment="Center"
                HorizontalAlignment="Center" Width="420" MinHeight="480">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="620">
            <StackPanel Spacing="16" VerticalAlignment="Center">
              <TextBlock Text="{Binding PanelTitle}" FontSize="28" FontWeight="SemiBold" Classes="primary-text"/>
              <TextBlock Text="演示账号：admin / 123456 或 demo / demo"
                         Classes="muted-text" FontSize="13"
                         IsVisible="{Binding !IsRegisterMode}"/>
              <TextBlock Text="注册后可立即使用本地账号登录工作台"
                         Classes="muted-text" FontSize="13"
                         IsVisible="{Binding IsRegisterMode}"/>

              <StackPanel Spacing="8" Margin="0,8,0,0"
                          IsVisible="{Binding IsRegisterMode}">
                <TextBlock Text="显示名称" Classes="field-label"/>
                <TextBox Text="{Binding DisplayName}" PlaceholderText="可选，默认与用户名相同" Classes="neon-input"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="用户名" Classes="field-label"/>
                <TextBox Text="{Binding Username}" PlaceholderText="输入用户名" Classes="neon-input"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="密码" Classes="field-label"/>
                <TextBox Text="{Binding Password}" PasswordChar="●"
                         PlaceholderText="输入密码" Classes="neon-input"/>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsRegisterMode}">
                <TextBlock Text="确认密码" Classes="field-label"/>
                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●"
                         PlaceholderText="再次输入密码" Classes="neon-input"/>
              </StackPanel>

              <CheckBox Content="记住我"
                        IsChecked="{Binding RememberMe}"
                        IsVisible="{Binding !IsRegisterMode}"
                        Classes="remember-me"/>

              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="{DynamicResource AppDangerBrush}"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap"/>

              <TextBlock Text="{Binding InfoMessage}"
                         Classes="accent-text"
                         IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap"/>

              <Button Classes="cta-button"
                      Command="{Binding SubmitCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Margin="0,4,0,0">
                <Panel>
                  <TextBlock Text="{Binding PrimaryButtonText}" IsVisible="{Binding !IsBusy}"
                             HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding BusyButtonText}" IsVisible="{Binding IsBusy}"
                             HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Panel>
              </Button>

              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="{Binding ModeSwitchHint}" Classes="muted-text" FontSize="13" VerticalAlignment="Center"/>
                <Button Classes="link-button"
                        Content="{Binding ModeSwitchActionText}"
                        Command="{Binding ToggleModeCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
              </StackPanel>

              <TextBlock Text=".NET 9 · Avalonia 12 · SQLite"
                         Classes="muted-text" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
