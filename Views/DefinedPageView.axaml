<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lana.ViewModels"
             xmlns:controls="using:Lana.Views.Controls"
             x:Class="Lana.Views.DefinedPageView"
             x:Name="Root"
             x:DataType="vm:DefinedPageViewModel">

  <Grid RowDefinitions="*,*" RowSpacing="12">
    <!-- 上半：摄像头预览 -->
    <Border Classes="glass-panel" Padding="10">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="摄像头预览" Classes="primary-text" FontWeight="SemiBold" FontSize="16"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="ghost-button" Content="刷新"
                  Command="{Binding RefreshAllCommand}"/>
        </Grid>

        <ItemsControl x:Name="PreviewHost"
                      ItemsSource="{Binding PreviewSlots}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding #PreviewHost.((vm:DefinedPageViewModel)DataContext).PreviewGridColumns}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CameraPreviewSlot">
              <controls:CameraVideoTile Margin="4"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        DataContext="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- 下半：自定义操作按钮 -->
    <Border Grid.Row="1" Classes="glass-panel" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Classes="accent-text"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding VariableActions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DefinedVariableAction">
                <Button Classes="cta-button"
                        Content="{Binding ButtonText}"
                        MinWidth="128"
                        MinHeight="44"
                        Margin="0,0,10,10"
                        Padding="16,10"
                        Command="{Binding #Root.((vm:DefinedPageViewModel)DataContext).ExecuteButtonCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding !IsBusy}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
